{
  "name": "nandepoly",
  "private": true,
  "version": "1.3.4",
  "description": "Juego de compra-venta de propiedades ambientado en Paraguay, online hasta 6 jugadores.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm --filter @nandepoly/server dev\" \"pnpm --filter @nandepoly/web dev\"",
    "build": "pnpm --filter @nandepoly/web build && pnpm --filter @nandepoly/server build",
    "test": "pnpm --filter @nandepoly/engine test",
    "start": "node apps/server/dist/index.js",
    "e2e": "node e2e/six-players.mjs",
    "e2e:bots": "node e2e/bots-smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "9.1.0",
    "playwright": "1.48.2",
    "socket.io-client": "4.8.1",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  }
}
